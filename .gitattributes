# LightGBM model fixtures are parsed with exact LF-delimited patterns in
# tests; keep blob bytes verbatim so Windows checkouts (core.autocrlf=true)
# don't turn \n into \r\n and silently skip test assertions.
common/smart/lightgbm/testdata/* -text

# nowhere vector fixtures are hashed as a tree in upstreamlock tests; keep
# blob bytes verbatim for the same reason as the LightGBM testdata.
protocol/nowhere/core/testdata/** -text
protocol/nowhere/core/wire/testdata/** -text
